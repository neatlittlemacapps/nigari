    "toast": {
      "$value": 900
    },
    "tooltip": {
      "$value": 1000
    },
    "top": {
      "$value": 1200
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 150,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 300,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "The ease-out every panel and menu uses."
      }
    }
  },
  "gradient": {
    "$type": "gradient",
    "rainbow": {
      "$value": [
        {
          "color": "{color.rainbow.red}",
