  "font": {
    "size": {
      "$type": "dimension",
      "$description": "Seven steps (research P3). Literal sizes move onto them batch by batch.",
      "2xs": {
        "$value": {
          "value": 11,
          "unit": "px"
        },
        "$description": "Absorbs 7–11.5px."
      },
      "xs": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "Absorbs 12 and 12.5px."
      },
      "sm": {
        "$value": {
          "value": 13,
          "unit": "px"
        },
        "$description": "Absorbs 13 and 13.5px."
      },
      "md": {
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$description": "Absorbs 14–15px."
      },
      "lg": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Absorbs 16–18px."
      },
      "xl": {
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "Absorbs 19–24px."
      },
      "display": {
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$description": "Page titles and empty states: fluid from 28px to 40px.",
        "$extensions": {
          "md.salt.cssValue": "clamp(28px, 4vw, 40px)"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Research P4. Under scale, because --radius-sm and --radius-lg already name today's 7px and 14px (semantic radius.legacy) and theme.css and the public pages read them.",
    "scale": {
      "xs": {
        "$value": {
          "value": 2,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 6,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "full": {
        "$value": {
          "value": 999,
          "unit": "px"
        }
      }
    }
  },
