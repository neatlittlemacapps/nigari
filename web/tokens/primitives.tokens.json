        },
        {
          "color": "{color.rainbow.yellow}",
          "position": 0.45
        },
        {
          "color": "{color.rainbow.green}",
          "position": 0.62
        },
        {
          "color": "{color.rainbow.blue}",
          "position": 0.8
        },
        {
          "color": "{color.rainbow.purple}",
          "position": 1
        }
      ],
      "$description": "The site's six stops. There is no second colour system."
    }
