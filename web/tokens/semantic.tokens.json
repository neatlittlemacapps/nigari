{
  "$description": "Roles. Each holds its light value in $value and its dark value in $extensions[\"md.salt.dark\"]: one token, two themes (FR-002). md.salt.css keeps the name styles.css already reads.",
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{color.paper.50}",
        "$extensions": {
          "md.salt.css": "--bg",
          "md.salt.dark": "{color.night.900}"
        },
        "$description": "The document."
      },
      "sidebar": {
        "$value": "{color.paper.100}",
        "$extensions": {
          "md.salt.css": "--sidebar-bg",
          "md.salt.dark": "{color.night.950}"
        },
        "$description": "The sidebar: one step off the document."
      },
      "raised": {
        "$value": "{color.paper.0}",
        "$extensions": {
          "md.salt.css": "--card",
          "md.salt.dark": "{color.night.850}"
        },
        "$description": "Cards, dialogs, menus."
      },
      "glass": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "alpha": 0.97,
          "hex": "#ffffff"
        },
        "$extensions": {
          "md.salt.css": "--glass",
          "md.salt.dark": {
            "colorSpace": "srgb",
            "components": [
              0.0745,
              0.0745,
              0.0941
            ],
            "alpha": 0.95,
            "hex": "#131318"
          }
        },
        "$description": "Nearly opaque on purpose: at 82% a menu over a code block showed a smudge of it through the blur."
      }
    },
    "text": {
      "default": {
        "$value": "{color.ink.900}",
        "$extensions": {
          "md.salt.css": "--fg",
          "md.salt.dark": "{color.mist.100}",
          "md.salt.contrast": [
            {
              "on": "{color.surface.default}",
              "min": 4.5
            },
            {
              "on": "{color.surface.sidebar}",
              "min": 4.5
            },
            {
              "on": "{color.surface.raised}",
              "min": 4.5
            }
          ]
        }
      },
      "muted": {
        "$value": "{color.ink.500}",
        "$extensions": {
          "md.salt.css": "--muted",
          "md.salt.dark": "{color.mist.500}",
          "md.salt.contrast": [
            {
              "on": "{color.surface.default}",
              "min": 4.5
            },
            {
              "on": "{color.surface.sidebar}",
              "min": 4.5
            },
            {
              "on": "{color.surface.raised}",
              "min": 4.5
            }
          ]
        },
        "$description": "Solid, never alpha: an emoji is drawn in the text colour's alpha."
      }
    },
    "accent": {
      "default": {
        "$value": "{color.pink.700}",
        "$extensions": {
          "md.salt.css": "--accent",
          "md.salt.dark": "{color.pink.400}",
          "md.salt.contrast": [
            {
              "on": "{color.surface.default}",
              "min": 4.5
            },
            {
              "on": "{color.surface.sidebar}",
              "min": 4.5
            },
            {
              "on": "{color.surface.raised}",
              "min": 4.5
            }
          ],
          "md.salt.rgb": "--accent-rgb"
        },
        "$description": "Text-safe on its surfaces in both themes."
      },
      "soft": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.702,
            0.0706,
            0.2471
          ],
          "alpha": 0.085,
          "hex": "#b3123f"
        },
        "$extensions": {
          "md.salt.css": "--accent-soft",
          "md.salt.dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              0.3608,
              0.502
            ],
            "alpha": 0.13,
            "hex": "#ff5c80"
          }
        },
        "$description": "A wash of the accent behind selected things."
      }
    },
    "danger": {
      "$value": "{color.orange.700}",
      "$extensions": {
        "md.salt.css": "--danger",
        "md.salt.dark": "{color.orange.400}",
        "md.salt.contrast": [
          {
            "on": "{color.surface.default}",
            "min": 4.5
          },
          {
            "on": "{color.surface.sidebar}",
            "min": 4.5
          },
          {
            "on": "{color.surface.raised}",
            "min": 4.5
          }
        ]
      }
    },
    "focus": {
      "$value": "{color.accent.default}",
      "$extensions": {},
      "$description": "The focus ring. The accent today; a token of its own so it can change without the accent."
    },
    "hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1098,
          0.102,
          0.0824
