{
  "$description": "Only where a component needs a value of its own (data-model.md).",
  "dialog": {
    "width": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 400,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 520,
          "unit": "px"
        },
        "$description": "Today's .dialog."
      },
      "lg": {
        "$value": {
          "value": 680,
          "unit": "px"
        },
        "$description": "Today's .dialog.wide."
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "Today's dialogs. Off the radius scale on purpose until every dialog has moved to Dialog (FR-016); then it joins radius.scale."
    },
    "padding": {
      "$type": "dimension",
      "$value": {
        "value": 22,
        "unit": "px"
      }
    },
    "layer": {
      "$type": "number",
      "$value": 100,
      "$description": "Today's overlay layer. Menus that open from inside a dialog sit at 200; layer.overlay (300) would put them under it. Moves to the layer scale with the menus (batch 2)."
    },
    "title": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "Today's dialog heading. Kept until every dialog uses Dialog, so old and new headings match (spec edge case: partial migration)."
      }
    },
    "backdrop": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000",
        "alpha": 0.35
      }
    }
  },
  "side-panel": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 720,
        "unit": "px"
      },
      "$description": "The side peek (spec 007): wide enough for a page's text column, capped at half the window by the component so the view stays usable."
    },
    "layer": {
      "$type": "number",
      "$value": 90,
      "$description": "Above sticky headers (layer.sticky 50) so the view's headers pass under it; below dialogs (dialog.layer 100) and menus (layer.dropdown 200), because both open from inside the peek and must draw over it."
    }
  },
  "center-panel": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 900,
        "unit": "px"
      },
      "$description": "The centre peek (spec 007): room for a page's text column with its margins, capped by the window."
    },
    "layer": {
      "$type": "number",
      "$value": "{side-panel.layer}",
      "$description": "The same layer as the side peek, for the same reason: dialogs and menus opened from the page inside it must draw over it."
    }
  },
  "button": {
    "height": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 26,
          "unit": "px"
        },
        "$description": "Today's .btn-sm: 5px padding, 12.5px text, hairline."
      },
      "md": {
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$description": "Today's .btn: 7px padding, 13.5px text, hairline."
      }
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      },
      "$description": "Inputs and selects line up with a medium button."
    }
  },
  "input": {
    "$description": "The settings dialog's fields (.settings-grid .prop-input).",
    "radius": {
      "$type": "dimension",
      "$value": "{radius.scale.lg}"
    },
    "padding": {
      "y": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "x": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "px"
        }
      }
    }
  },
  "editor": {
    "$description": "BlockNote's Mantine theme (FR-011). Its menus read --bn-* custom properties on .bn-container; set from these, the slash menu, the formatting bar and their dropdowns are the same panel as every other menu and follow the tokens. Written under [data-theme], which outranks BlockNote's own [data-color-scheme] rules.",
    "menu": {
      "background": {
        "$type": "color",
        "$value": "{color.surface.glass}",
        "$extensions": {
          "io.github.neatlittlemacapps.nigari.css": "--bn-colors-menu-background",
          "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.default}",
        "$extensions": {
          "io.github.neatlittlemacapps.nigari.css": "--bn-colors-menu-text",
          "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
        }
      }
    },
    "tooltip": {
      "background": {
        "$type": "color",
        "$value": "{color.surface.raised}",
        "$extensions": {
          "io.github.neatlittlemacapps.nigari.css": "--bn-colors-tooltip-background",
          "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
        },
        "$description": "BlockNote uses its tooltip pair for three things at once: the icon box beside each slash-menu entry, the shortcut badge and the real tooltip. Ink here turned the slash menu into a column of black squares, so the pair stays quiet; theme.css gives the real tooltip its ink on its own."
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.default}",
        "$extensions": {
          "io.github.neatlittlemacapps.nigari.css": "--bn-colors-tooltip-text",
          "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
        }
      }
    },
    "hovered": {
      "background": {
        "$type": "color",
        "$value": "{color.active}",
        "$extensions": {
          "io.github.neatlittlemacapps.nigari.css": "--bn-colors-hovered-background",
          "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.default}",
        "$extensions": {
          "io.github.neatlittlemacapps.nigari.css": "--bn-colors-hovered-text",
          "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
        }
      }
    },
    "selected": {
      "background": {
        "$type": "color",
        "$value": "{color.active}",
        "$extensions": {
          "io.github.neatlittlemacapps.nigari.css": "--bn-colors-selected-background",
          "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.default}",
        "$extensions": {
          "io.github.neatlittlemacapps.nigari.css": "--bn-colors-selected-text",
          "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
        }
      }
    },
    "disabled": {
      "text": {
        "$type": "color",
        "$value": "{color.text.muted}",
        "$extensions": {
          "io.github.neatlittlemacapps.nigari.css": "--bn-colors-disabled-text",
          "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}",
      "$extensions": {
        "io.github.neatlittlemacapps.nigari.css": "--bn-colors-border",
        "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.legacy.md}",
      "$extensions": {
        "io.github.neatlittlemacapps.nigari.css": "--bn-border-radius",
        "io.github.neatlittlemacapps.nigari.selector": "[data-theme] .bn-container, [data-theme] .bn-root"
      }
    }
  },
  "chart": {
    "height": {
      "$description": "A chart's height setting (spec 004, FR-024). Medium fits a chart beside text without scrolling; extra large is for a chart that is the page.",
      "small": {
        "$type": "dimension",
        "$value": {
          "value": 200,
          "unit": "px"
        }
      },
      "medium": {
        "$type": "dimension",
        "$value": {
          "value": 320,
          "unit": "px"
        }
      },
      "large": {
        "$type": "dimension",
        "$value": {
          "value": 440,
          "unit": "px"
        }
      },
      "xlarge": {
        "$type": "dimension",
        "$value": {
          "value": 600,
          "unit": "px"
        }
      }
    }
  },
  "popover": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 320,
        "unit": "px"
      },
      "$description": "ui/Popover's panel (spec 004, the chart settings): Notion's panel is about this wide, room for a labelled dropdown and a row of five kind buttons. Capped at the window by the component."
    },
    "layer": {
      "$type": "number",
      "$value": 150,
      "$description": "Above dialogs (dialog.layer 100) and the peeks (side-panel.layer 90), so a chart's settings open over a chart shown in a peek; below menus (layer.dropdown 200), because a Select inside the popover opens its list over it."
    }
  }
}
