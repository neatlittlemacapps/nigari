[Unit]
Description=nigari — lightweight open-source workspace
After=network.target

[Service]
User=nigari
Group=nigari
WorkingDirectory=/opt/nigari
ExecStart=/opt/nigari/nigari
Environment=NIGARI_ADDR=:80
Environment=NIGARI_DATA=/opt/nigari/data
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=false
Restart=on-failure
RestartSec=2
# The binary drains in-flight requests and checkpoints SQLite on SIGTERM
# (systemd's default stop signal); bound the wait so a stuck request can't hang
# a restart forever.
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
